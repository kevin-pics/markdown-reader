{
  "manifest_version": 3,
  "name": "Markdown Reader",
  "version": "1.0",
  "description": "Render local Markdown files with file explorer and TOC sidebar.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "file://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file://*/*.md",
        "file://*/*.markdown",
        "file://*/*.mdown",
        "file://*/*.mkd",
        "file://*/*.mkdn"
      ],
      "run_at": "document_start",
      "js": [
        "marked.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
